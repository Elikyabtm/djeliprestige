# Envoi automatique du formulaire de contact — choisir UNE méthode.
# À renseigner dans .env.local (en local) et dans Vercel > Settings > Environment Variables.

# --- Méthode A : Resend (recommandée, pas besoin de mot de passe Gmail) ---
# 1. Créer un compte sur https://resend.com AVEC l'adresse djeliprestige@gmail.com
# 2. API Keys > Create API Key (permission « Sending access »)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# Optionnel, une fois un nom de domaine vérifié dans Resend :
# RESEND_FROM=contact@votre-domaine.fr

# --- Méthode B : Gmail SMTP (nécessite la validation en deux étapes) ---
# Mot de passe d'application : https://myaccount.google.com/apppasswords
# SMTP_USER=djeliprestige@gmail.com
# SMTP_PASS=xxxxxxxxxxxxxxxx
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465

# Optionnel : destinataire (défaut : djeliprestige@gmail.com)
# CONTACT_TO=djeliprestige@gmail.com
